#!/usr/bin/env ruby

# Load specific gem versions for aicommit without affecting the user's environment
# This approach isolates our dependencies from the user's Gemfile
require "rubygems"

# Explicitly require our dependencies with their versions instead of using bundler/setup
require "optparse"
require "colorize"
require_relative "../lib/aicommit"
require_relative "../lib/aicommit/version"
require_relative "../lib/pr_description_generator"
require_relative "../lib/ignore_file_checker"

options = {}
parser = OptionParser.new do |op|
  op.banner = "Usage: aicommit [options]"

  op.on("-p [BASE_REF]", "--pr-description [BASE_REF]", "Generate PR description, optionally specify a base ref (branch name or commit SHA)") do |pr|
    options[:pr_description] = true
    options[:pr_base_ref] = pr
  end

  op.on("--file [FILENAME]", "Save PR description to a file (default: PR_DESCRIPTION.md)") do |filename|
    options[:file] = filename || true
  end

  op.on("--clipboard", "Copy PR description to clipboard") do
    options[:clipboard] = true
  end

  op.on("-v", "--version", "Show version") do |v|
    options[:version] = v
  end

  op.on("--key", "Set OpenAI API key") do |k|
    options[:key] = k
  end

  op.on("--model", "Set OpenAI model") do |m|
    options[:model] = m
  end

  op.on("--base-branch", "Set base branch name") do |bb|
    options[:base_branch] = bb
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption
  puts "Invalid option, please see `aicommit -h` for help"
  puts parser.help
  exit
end

IgnoreFileChecker.new.ensure_env_in_ignore_file

if options[:version]
  puts Aicommit::VERSION
elsif options[:key]
  Envs::OpenaiApiKey.new.update!
elsif options[:model]
  current_selected_model = Envs::SelectedModel.new.fetch
  if current_selected_model
    puts "Current model: #{current_selected_model}"
    puts ""
  end

  Envs::SelectedModel.new.update!
elsif options[:base_branch]
  Envs::BaseBranch.new.update!
elsif options[:pr_description]
  # By default, save to file if neither option is specified
  options[:file] = true if !options[:file] && !options[:clipboard]

  PrDescriptionGenerator.new(options[:pr_base_ref], options).run
elsif ARGV.empty?
  Aicommit.run
else
  puts parser.help
end
