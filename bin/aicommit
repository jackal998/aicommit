#!/usr/bin/env ruby
require "bundler/setup"

require "optparse"
require "colorize"
require_relative "../lib/aicommit"
require_relative "../lib/aicommit/version"
require_relative "../lib/pr_description_generator"

options = {}
parser = OptionParser.new do |op|
  op.banner = "Usage: aicommit [options]"

  op.on("-v", "--version", "Show version") do |v|
    options[:version] = v
  end

  op.on("--key", "Set OpenAI API key") do |k|
    options[:key] = k
  end

  op.on("--model", "Set OpenAI model") do |m|
    options[:model] = m
  end

  op.on("--main-branch", "Set main branch name") do |mb|
    options[:main_branch] = mb
  end

  op.on("-pd", "--pr-description", "Generate PR description") do |pr|
    options[:pr_description] = pr
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption
  puts "Invalid option, please see `aicommit -h` for help"
  puts parser.help
  exit
end

if options[:version]
  puts Aicommit::VERSION
elsif options[:key]
  Envs::OpenaiApiKey.new.update!
elsif options[:model]
  current_selected_model = Envs::SelectedModel.new.fetch
  if current_selected_model
    puts "Current model: #{current_selected_model}"
    puts ""
  end

  Envs::SelectedModel.new.update!
elsif options[:main_branch]
  Envs::MainBranch.new.update!
elsif options[:pr_description]
  PrDescriptionGenerator.new.run
elsif ARGV.empty?
  Aicommit.run
else
  puts parser.help
end
